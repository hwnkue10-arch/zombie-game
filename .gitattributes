# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly ensure Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicitly ensure shell scripts use LF
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.tar.gz binary
*.pdf binary
